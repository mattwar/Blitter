namespace Blitter.Blocks3D;

public interface ISpriteHost3D
{
    /// <summary>
    /// The time elapsed since the host was created.
    /// </summary>
    TimeSpan Elapsed { get; }

    /// <summary>
    /// Add a sprite to this host.
    /// </summary>
    void AddSprite(Sprite3D s);

    /// <summary>
    /// Remove a sprite from this host.
    /// </summary>
    void RemoveSprite(Sprite3D s);

    /// <summary>
    /// Add a barrier to this host.
    /// </summary>
    void AddBarrier(Barrier3D b);

    /// <summary>
    /// Remove a barrier from this host.
    /// </summary>
    void RemoveBarrier(Barrier3D b);    
}